# ── Example environment for the pi coding harness (demo/05-pi-coding.py) ──────
# Copy to .env and fill in your values:   cp .env.example .env
# The harness loads the project-root .env with python-dotenv.
# Never commit your real .env — only this template.

# ══════════════════════════════════════════════════════════════════════════════
# GitHub (required) — used for git clone / push and `gh pr create`
# ══════════════════════════════════════════════════════════════════════════════
# PAT with `repo` scope (and `workflow` if the target repo has workflows).
PAT="github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Target repository as owner/repo.
GITHUB_REPO="your-org/your-repo"
# Branch to clone from.
GITHUB_BASE_BRANCH="main"
# Branch to push to (auto-generated as pi-<run_id> if blank).
GITHUB_BRANCH=""
# Natural-language task for the coding agent.
CODING_PROMPT="Read task.md if present. Fix bugs, add a CHANGES.md summarising your changes, then run the tests."

# ══════════════════════════════════════════════════════════════════════════════
# Sandbox / Azure Container Apps (required)
# ══════════════════════════════════════════════════════════════════════════════
RESOURCE_GROUP_NAME="aca-sandboxes-rg"
SANDBOX_GROUP_NAME="pi-coding"
LOCATION="westus3"
# Extra egress hosts allowed after lockdown (space/comma separated, globs ok).
EGRESS_EXTRA_HOSTS="*.microsoft.com"

# ══════════════════════════════════════════════════════════════════════════════
# LLM provider for pi (required) — choose ONE of the options below
# ══════════════════════════════════════════════════════════════════════════════
# anthropic | openai | google | azure
PI_PROVIDER="azure"
# Optional model pattern/id passed to `pi --model` (ignored for azure — the
# Azure deployment name is used as the model id).
# PI_MODEL="sonnet"

# ── Option A: API-key providers (PI_PROVIDER=anthropic|openai|google) ─────────
# Set the key that matches PI_PROVIDER:
# ANTHROPIC_API_KEY="sk-ant-xxxx"
# OPENAI_API_KEY="sk-xxxx"
# GEMINI_API_KEY="xxxx"

# ── Option B: Azure OpenAI / Foundry (PI_PROVIDER=azure) ──────────────────────
# The harness reads these existing Foundry coordinates automatically:
#   - Endpoint: AZURE_AI_PROJECT_ENDPOINT (preferred) or AZURE_OPENAI_ENDPOINT
#   - Model:    AZURE_AI_MODEL_DEPLOYMENT_NAME
#   - Account scope for RBAC: derived from AZURE_AI_PROJECT_ID
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_AI_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"
AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4.1-mini"
AZURE_AI_PROJECT_ID="/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>"
# Needed by scripts/deploy_managed_identity.sh for naming/region:
AZURE_ENV_NAME="dev"
AZURE_LOCATION="swedencentral"

# Managed identity (recommended) — provision with:
#   ./scripts/deploy_managed_identity.sh
# then paste the two values it prints below. When set, the harness attaches this
# user-assigned identity to the sandbox group and uses a short-lived Entra token
# (no API key ever touches the sandbox).
AZURE_MANAGED_IDENTITY_CLIENT_ID=""
AZURE_MANAGED_IDENTITY_RESOURCE_ID=""

# ── Azure advanced / optional overrides ──────────────────────────────────────
# Force a specific base URL (overrides the endpoints above).
# AZURE_OPENAI_BASE_URL="https://<resource>.services.ai.azure.com/openai/v1"
# Override the deployment used as the pi model id.
# AZURE_OPENAI_DEPLOYMENT="gpt-4.1-mini"
# pi API type: openai-responses (default) or openai-completions.
# AZURE_OPENAI_API="openai-responses"
# Explicit account scope for the runtime role grant (else derived from project id).
# AZURE_OPENAI_ACCOUNT_RESOURCE_ID="/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>"
# Use an API key instead of a managed identity (opt out of MI).
# AZURE_OPENAI_API_KEY="<key>"
